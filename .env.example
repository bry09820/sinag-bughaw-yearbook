APP_NAME="Sinag-Bughaw"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.hostinger.com
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# MySQL (Hostinger)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Frontend (Vercel) — used by PayMongo redirects & SocialAuth
FRONTEND_URL=https://sinag-bughaw.vercel.app

# Comma-separated SPA origins allowed to call this API
CORS_ALLOWED_ORIGINS=https://sinag-bughaw.vercel.app,https://sinagbughawadmin.vercel.app

# Domains that may use cookie-based Sanctum SPA auth (host only, no scheme)
SANCTUM_STATEFUL_DOMAINS=your-domain.hostinger.com,sinag-bughaw.vercel.app,sinagbughawadmin.vercel.app
SANCTUM_EXPIRATION=480

# Mail (Brevo)
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

BREVO_API_KEY=
BREVO_FROM_ADDRESS="${MAIL_FROM_ADDRESS}"
BREVO_FROM_NAME="${APP_NAME}"

# AWS Rekognition (use ap-southeast-1 for PH latency)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_REGION=ap-southeast-1
AWS_REKOGNITION_COLLECTION=nu-lipa-yearbook
AWS_REKOGNITION_THRESHOLD=90
FACE_RECOGNITION_THRESHOLD=90

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# PayMongo
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_MOBILE_REDIRECT_URI=

# Groq Whisper (optional)
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Seed passwords (change immediately after first deploy)
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_DEMO_DATA=false
