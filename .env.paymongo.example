# PayMongo (copy into .env)
PAYMONGO_SECRET_KEY=sk_test_your_secret_key
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_secret

# Used for checkout success/cancel redirects
FRONTEND_URL=http://localhost:5173

# Webhook URLs to register in the PayMongo dashboard:
#   POST https://your-domain.com/api/paymongo/webhook
#   POST https://your-domain.com/api/payments/webhook
# Listen for: checkout_session.payment.paid, payment.paid
