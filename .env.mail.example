# ---------------------------------------------------------------------------
# MAIL (Laravel 12)
# ---------------------------------------------------------------------------
# Drivers:
#   log       — OTP written to storage/logs/laravel.log (best for local mobile)
#   smtp      — Brevo / Mailtrap / Gmail
#   failover  — try smtp, then fall back to log
#
# Laravel 12 uses MAIL_SCHEME (empty for STARTTLS:587, smtps for SSL:465).
# Do NOT rely on MAIL_ENCRYPTION (removed in Laravel 11+).
#
MAIL_MAILER=failover
MAIL_SCHEME=
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Mailtrap example:
# MAIL_MAILER=smtp
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=

# Gmail example (App Password required):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=
# MAIL_FROM_ADDRESS=

BREVO_API_KEY=
BREVO_FROM_ADDRESS="${MAIL_FROM_ADDRESS}"
BREVO_FROM_NAME="${MAIL_FROM_NAME}"
BREVO_HOST=smtp-relay.brevo.com
BREVO_PORT=587
BREVO_USERNAME=
BREVO_PASSWORD=
BREVO_SCHEME=
